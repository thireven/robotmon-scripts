{
  // settings.ts is the configuration UI script. It is loaded directly by
  // index.html (<script src="settings.js">) and must stay a standalone file --
  // it is NOT part of the bundled game script (see tsconfig.json). This config
  // emits build/settings.js on its own, one input -> one output.
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5", "DOM"],
    "module": "none",
    "outDir": "./build",
    "rootDir": "./src",
    "removeComments": false,
    "newLine": "lf",
    // Not `strict` yet: settings.ts is a direct port of the original
    // settings.js and still leans on implicit any in its jQuery rendering. The
    // checks below are the ones it does pass, and they are what catch a
    // mistyped Settings key -- the failure that actually costs anything here.
    "strict": false,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "ignoreDeprecations": "6.0"
  },
  "files": [
    "src/shared.d.ts",
    "src/settings.d.ts",
    "src/settings.ts"
  ]
}
